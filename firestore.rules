rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection - each user can only read/write their own data
    match /users/{userId} {
      // Allow authenticated users to read their own document identified by stored `uid` field
      // Also allow reading a non-existent doc so client can detect and create it.
      allow read: if request.auth != null && (resource == null || resource.data.uid == request.auth.uid);

      // Allow creating a user document only if the `uid` field matches the authenticated user
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;

      // Allow updates only if the existing document's `uid` matches the authenticated user
      allow update: if request.auth != null && resource.data.uid == request.auth.uid;

      // Prevent client-side deletes
      allow delete: if false;
    }

    // Allow read-only access to public leaderboard (optional)
    match /leaderboard/{document=**} {
      allow read: if request.auth.uid != null;
      allow write: if false; // Server-only operations
    }

    // Default: deny all access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
